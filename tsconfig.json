{
  "compilerOptions": {
    "baseUrl": "src",
    "esModuleInterop": true,
    "lib": ["es2023"],
    "module": "preserve",
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2023",
  },
  "typedocOptions": {
    "exclude": [
      "**/*.test.ts",
      "**/__mocks__/*.ts"
    ],
    "mode": "modules",
    "out": "docs"
  }
}
